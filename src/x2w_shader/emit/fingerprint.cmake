# cmake -DSRC=<src dir> -DOUT=<header> -P fingerprint.cmake: the translator's source fingerprint and the
# X2W_SHADERCFG_* switches it reads. Hash sorted sources and relative paths with SHA-256. Write OUT only
# when it changes. Run at build time from cmake/x_translate.cmake.
file(GLOB_RECURSE files "${SRC}/x2w_shader/*.h" "${SRC}/x2w_shader/*.cpp")
list(SORT files)
set(text "")
set(switches "")
foreach(f IN LISTS files)
    file(RELATIVE_PATH rel "${SRC}" "${f}")
    file(READ "${f}" body)
    string(APPEND text "${rel}\n${body}\n")
    string(REGEX MATCHALL "\"X2W_SHADERCFG_[A-Z0-9_]+\"" found "${body}")
    foreach(s IN LISTS found)
        string(REPLACE "\"" "" s "${s}")
        list(APPEND switches "${s}")
    endforeach()
endforeach()
string(SHA256 hash "${text}")
list(REMOVE_DUPLICATES switches)
list(SORT switches)
string(REPLACE ";" "," switches "${switches}")
set(content "#define X2W_VS_SOURCE_HASH \"${hash}\"\n#define X2W_VS_SWITCHES \"${switches}\"\n")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUT}" "${content}")
endif()
